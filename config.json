{
  "config_version": 1,
  "extensions": [
    "mp4",
    "mov",
    "mkv",
    "avi",
    "flv",
    "ts",
    "m2ts",
    "mpg",
    "webm",
    "m4v",
    "wmv",
    "3gp"
  ],
  "jobs": 2,
  "timeout_sec": 3600,
  "quick_check_on_select": true,
  "pts_gap_factor": 3.0,
  "pts_gap_min": 0.2,
  "freeze_noise": 0.003,
  "freeze_min_sec": 2.0,
  "black_min_sec": 0.5,
  "silence_db": -50.0,
  "silence_min_sec": 3.0,
  "mean_volume_low_db": -30.0,
  "silent_mean_db": -45.0,
  "clipping_db": -0.1,
  "require_audio": true,
  "av_offset_sec": 0.5,
  "truncation_gap_sec": 2.0,
  "color_cast_threshold": 25.0,
  "color_sample_sec": 5.0,
  "color_window_samples": 3,
  "hdr_tonemap": true,
  "report_dir": "reports"
}
