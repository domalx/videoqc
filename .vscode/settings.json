{
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.terminal.activateEnvironment": true,
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],
  "python.analysis.extraPaths": ["${workspaceFolder}"],
  "python.analysis.exclude": ["**/dist/**", "**/bin/**", "**/download/**"],

  "files.encoding": "utf8",
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    ".venv": true,
    ".pytest_cache": true,
    ".mypy_cache": true,
    ".ruff_cache": true,
    ".workbuddy": true,
    "bin": true,
    "dist": true,
    "download": true,
    "logs": true,
    "reports": true
  },
  "search.exclude": {
    "**/__pycache__": true,
    ".venv": true,
    ".pytest_cache": true,
    ".mypy_cache": true,
    ".ruff_cache": true,
    ".workbuddy": true,
    "bin": true,
    "dist": true,
    "download": true,
    "logs": true,
    "reports": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/dist/**": true,
    "**/download/**": true,
    "**/bin/**": true,
    "**/__pycache__/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.workbuddy/**": true,
    "**/reports/**": true
  },
  "explorer.compactFolders": false,

  "[python]": {
    "editor.rulers": [100],
    "editor.tabSize": 4
  },
  "[json]": { "editor.tabSize": 2 },
  "[markdown]": { "editor.wordWrap": "on" }
}
