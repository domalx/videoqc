{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GUI (videoqc)",
      "type": "debugpy",
      "request": "launch",
      "module": "videoqc",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "Headless: 扫描测试素材",
      "type": "debugpy",
      "request": "launch",
      "module": "videoqc",
      "args": ["--headless", "${workspaceFolder}/tests/data"],
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "pytest: 当前文件",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-v"],
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
